# Copie para .env. O .env NUNCA vai para o git.
SB_DB_USER=sacibras
SB_DB_PASSWORD=sacibras
SB_DB_NAME=sacibras

# Cache local do builder (opcional). Sem ela, o builder vai direto às APIs.
SB_CACHE_URL=postgresql+psycopg://sacibras:sacibras@localhost:5434/sacibras

# Liga as fontes que leem o site da B3 (índices setoriais, futuros). Desligado por padrão:
# a B3 veda coleta automatizada no texto do site. Ver docs/FONTES.md antes de ligar.
# SB_B3=1
